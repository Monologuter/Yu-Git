#!/bin/sh
# 驭Git pre-push：推送前跑全量测试
# 规范见 docs/04-工程规范.md §12.1
#
# main 始终测试全绿是不可协商的约束（§1.5），推送是最后一道拦截点。

root=$(git rev-parse --show-toplevel)

if ! command -v swift >/dev/null 2>&1; then
    echo "⚠️  找不到 swift，跳过测试"
    exit 0
fi

for package in "$root"/Packages/*/; do
    [ -f "$package/Package.swift" ] || continue
    name=$(basename "$package")

    printf '▶︎ 测试 %s\n' "$name"
    # `< /dev/null` 不能省。git 调用 pre-push 时会把待推送的引用列表写进 hook 的
    # stdin，并且**在 hook 退出前一直保持那个管道打开**。这个 hook 自己不读 stdin，
    # 但它派生的 swift test 会把 stdin 原样传给测试进程，测试里成百上千个 git
    # 子进程又各自继承一份——只要其中任何一个去读 stdin，它就会永远等在那里，
    # 而 git 也在等 hook 退出。整个 push 就此挂死，没有超时也没有任何输出
    # （hook 的输出这时还堵在管道里）。
    if ! swift test --package-path "$package" < /dev/null; then
        printf '\n❌ %s 测试未通过，推送已取消\n' "$name"
        printf '如确需跳过：git push --no-verify\n'
        exit 1
    fi
done

exit 0
