      {
        "selector": "JSXOpeningElement[name.name='SelectionBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|primaryLabel|onApply|onClear|style|key|ref|className|style|children)$/]",
        "message": "<SelectionBar> doesn't accept that prop. Declared props: count, primaryLabel, onApply, onClear, style."
