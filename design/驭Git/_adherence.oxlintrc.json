{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/badges/**",
              "components/controls/**",
              "components/core/**",
              "components/diff/**",
              "components/feedback/**",
              "components/graph/**",
              "components/rows/**",
              "ui_kits/first-run/**",
              "ui_kits/mac-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|headline|detail|actions|footnote|style|key|ref|className|style|children)$/]",
        "message": "<Banner> doesn't accept that prop. Declared props: tone, headline, detail, actions, footnote, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:warn|danger|info|ok)$/]",
        "message": "<Banner> tone must be one of 'warn' | 'danger' | 'info' | 'ok'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BranchRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|isRemote|isCurrent|selected|ahead|behind|gone|title|onClick|style|key|ref|className|style|children)$/]",
        "message": "<BranchRow> doesn't accept that prop. Declared props: name, isRemote, isCurrent, selected, ahead, behind, gone, title, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|disabled|fullWidth|onClick|title|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, disabled, fullWidth, onClick, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|bordered|borderless|destructive)$/]",
        "message": "<Button> variant must be one of 'default' | 'bordered' | 'borderless' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:small|regular|large)$/]",
        "message": "<Button> size must be one of 'small' | 'regular' | 'large'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, onChange, label, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CommitRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:subject|hash|author|date|refs|isMerge|isHead|graphRow|laneCount|selected|onClick|style|key|ref|className|style|children)$/]",
        "message": "<CommitRow> doesn't accept that prop. Declared props: subject, hash, author, date, refs, isMerge, isHead, graphRow, laneCount, selected, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CopyButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|title|onCopy|style|key|ref|className|style|children)$/]",
        "message": "<CopyButton> doesn't accept that prop. Declared props: text, title, onCopy, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CountPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<CountPill> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CountPill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|warn)$/]",
        "message": "<CountPill> tone must be one of 'neutral' | 'warn'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DayGroupRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|count|style|key|ref|className|style|children)$/]",
        "message": "<DayGroupRow> doesn't accept that prop. Declared props: label, count, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DiffSegment'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|syn|changed|key|ref|className|style|children)$/]",
        "message": "<DiffSegment> doesn't accept that prop. Declared props: text, syn, changed."
      },
      {
        "selector": "JSXOpeningElement[name.name='DiffSegment'] > JSXAttribute[name.name='syn'] > Literal[value!=/^(?:keyword|string|comment|number|type|plain)$/]",
        "message": "<DiffSegment> syn must be one of 'keyword' | 'string' | 'comment' | 'number' | 'type' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DirectoryRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|count|collapsed|depth|action|onToggle|title|style|key|ref|className|style|children)$/]",
        "message": "<DirectoryRow> doesn't accept that prop. Declared props: name, count, collapsed, depth, action, onToggle, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|description|action|tone|compact|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, title, description, action, tone, compact, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brand|warn)$/]",
        "message": "<EmptyState> tone must be one of 'brand' | 'warn'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExplanationPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|text|loading|expanded|onToggle|error|style|key|ref|className|style|children)$/]",
        "message": "<ExplanationPanel> doesn't accept that prop. Declared props: title, text, loading, expanded, onToggle, error, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FileRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|name|directory|selected|depth|onClick|title|style|key|ref|className|style|children)$/]",
        "message": "<FileRow> doesn't accept that prop. Declared props: status, name, directory, selected, depth, onClick, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FileRow'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:added|modified|deleted|renamed|copied|untracked|unmerged|ignored|typechange)$/]",
        "message": "<FileRow> status must be one of 'added' | 'modified' | 'deleted' | 'renamed' | 'copied' | 'untracked' | 'unmerged' | 'ignored' | 'typechange'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|autoFocus|style|key|ref|className|style|children)$/]",
        "message": "<FilterField> doesn't accept that prop. Declared props: value, onChange, placeholder, autoFocus, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HazardDialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|whatHappens|undoable|howToUndo|command|confirmLabel|onConfirm|onCancel|style|key|ref|className|style|children)$/]",
        "message": "<HazardDialog> doesn't accept that prop. Declared props: title, whatHappens, undoable, howToUndo, command, confirmLabel, onConfirm, onCancel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HunkHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:header|action|sticky|style|key|ref|className|style|children)$/]",
        "message": "<HunkHeader> doesn't accept that prop. Declared props: header, action, sticky, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|title|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GraphLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:fromLane|toLane|colorIndex|isHead|key|ref|className|style|children)$/]",
        "message": "<GraphLink> doesn't accept that prop. Declared props: fromLane, toLane, colorIndex, isHead."
      },
      {
        "selector": "JSXOpeningElement[name.name='RefBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|children|emphasized|style|key|ref|className|style|children)$/]",
        "message": "<RefBadge> doesn't accept that prop. Declared props: kind, children, emphasized, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RefBadge'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:local|remote|tag)$/]",
        "message": "<RefBadge> kind must be one of 'local' | 'remote' | 'tag'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|count|tone|action|sticky|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: title, count, tone, action, sticky, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|warn)$/]",
        "message": "<SectionHeader> tone must be one of 'neutral' | 'warn'."
      },
