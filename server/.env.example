# 复制成 .env 并填好。.env 不进版本控制。

# 数据库密码，随便生成一个：openssl rand -base64 24
DB_PASSWORD=

# ── 上游 ──────────────────────────────────────────────────────
# 至少填一个。没填 key 的上游不会被启用。
# 这台机器连不上 OpenAI，Anthropic 也被按地区拒绝，所以只列国内可直连的。
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=

# ── 路由 ──────────────────────────────────────────────────────
# 对外只有 yugit-standard / yugit-pro 两个套餐名，客户端看不到底层是谁，
# 换供应商时不用改客户端，已发布的版本也不受影响。
#
# 只配了一个上游时下面两项可以留空，网关会自动用那一个。
# 配了多个就必须指定，否则启动会报错——宁可起不来，
# 也好过让用户在发请求时收到一句「不支持的模型」。
STANDARD_UPSTREAM=
PRO_UPSTREAM=

# 模型名必须显式指定，没有默认值。
# 通义：qwen-turbo / qwen-plus / qwen-max / qwen3-max / qwen3-coder-plus
# DeepSeek：deepseek-chat / deepseek-reasoner
STANDARD_MODEL=qwen-plus
PRO_MODEL=qwen3-coder-plus
