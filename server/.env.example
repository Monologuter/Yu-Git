# 复制成 .env 并填好。.env 不进版本控制。

# 数据库密码，随便生成一个：openssl rand -base64 24
DB_PASSWORD=

# 上游 API key。至少填一个，没填的上游不会被启用。
# 这台机器连不上 OpenAI，Anthropic 也被按地区拒绝，所以只列国内可直连的。
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=

# 对外的两个套餐分别用哪个上游模型。
# 客户端只看到 yugit-standard / yugit-pro，换供应商不用改客户端。
STANDARD_MODEL=deepseek-chat
PRO_MODEL=deepseek-reasoner
